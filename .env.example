# Local server only. Use 0 ONLY on loopback HTTP during development.
SECURE_COOKIES=1
DATABASE_PATH=private/golicoach.sqlite
PORT=8000
# Leave empty for same-origin backend. Static Sites run browser/device mode.
NEXT_PUBLIC_API_BASE=
NEXT_TELEMETRY_DISABLED=1

# Required for production account verification/recovery. No mail is sent until configured.
REQUIRE_EMAIL_VERIFICATION=1
APP_ORIGIN=https://your-own-golicoach-domain.example
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Docker HTTPS proxy; APP_ORIGIN must match https://DOMAIN.
DOMAIN=your-own-golicoach-domain.example

# On the Netlify build only: bare HTTPS backend origin, blank keeps device mode.
BACKEND_ORIGIN=
# Set 0 on a backend behind the Netlify proxy; keep video analysis in browser.
SERVER_VIDEO_ENABLED=1
